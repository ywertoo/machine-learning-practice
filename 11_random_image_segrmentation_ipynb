      "source": [
        "def generate_p_data(num_samples=100, img_size=128):\n",
        "\n",
        "    X = np.random.choice(\n",
        "        [0.8, 0.4, 0.1],  # 이미지 픽셀 타입\n",
        "        size=(num_samples, img_size, img_size, 1),\n",
        "        p=[0.05, 0.25, 0.7]  # 픽셀 비율 설정\n",
        "    )\n",
        "    Y = (X > 0.5).astype(np.float32)  # Threshold를 기준으로 마스크 생성\n",
        "    return X, Y"
      ]
